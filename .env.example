# Plantilla de variables de entorno. Copiar a .env y completar con valores reales.
# NUNCA poner credenciales reales en este archivo: sí se sube a git.

# Cadena de conexión a PostgreSQL 16.
DATABASE_URL="postgresql://USUARIO:CONTRASENA@localhost:5432/acervo_dev?schema=public"

# Los tests de integración usan su propia base. Copiar a .env.test
# DATABASE_URL="postgresql://USUARIO:CONTRASENA@localhost:5432/acervo_test?schema=public"

# Datos de la primera cuenta de administrador, solo para el seed.
# Si se omite SEED_ADMIN_PASSWORD, el seed genera una y la muestra una vez.
# SEED_ADMIN_EMAIL="admin@colegio.edu.co"
# SEED_ADMIN_NAME="Nombre Apellido"
# SEED_ADMIN_PASSWORD=""
