// Esquema de datos de Acervo.
// Módulo identity: personal del colegio, autenticación y auditoría.
// No existen cuentas de estudiantes ni de familias (decisión cerrada n.º 3).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Roles del personal. Solo estos dos.
enum Role {
  ADMIN
  DOCENTE
}

/// Cuenta de un miembro del personal. La lista de usuarios es la única
/// frontera de acceso al panel interno.
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String
  image         String?
  passwordHash  String
  role          Role      @default(DOCENTE)
  isActive      Boolean   @default(true)

  // Bloqueo por intentos fallidos de ingreso.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts            Account[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]
  decidedRequests     DocumentRequest[]

  @@index([role])
}

/// Requerido por el adaptador de Auth.js.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Restablecimiento de contraseña. Se guarda solo el hash del token:
/// el valor en claro viaja por correo y nunca toca la base de datos.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Registro de acciones administrativas. Nunca debe contener nombres
/// completos ni correos de estudiantes.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([createdAt])
  @@index([entityType, entityId])
}

/// Ciclo de vida de una publicación. Solo PUBLISHED es visible al público.
enum ProjectStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

/// Proyecto académico de estudiantes.
model Project {
  id      String @id @default(cuid())
  /// Identificador legible usado en la URL pública.
  slug    String @unique
  title   String
  summary String

  /// Área académica. Queda como texto libre hasta que se defina la lista
  /// oficial del colegio; convertirla en enum después es una migración simple.
  area String

  /// 0 corresponde a preescolar y 1 a 11 a los grados de primero a once.
  gradeLevel Int

  /// Año lectivo en que se desarrolló el proyecto.
  year Int

  status      ProjectStatus @default(DRAFT)
  publishedAt DateTime?

  /// Título, resumen y área en minúsculas y sin tildes. Existe porque en
  /// español la gente busca sin tildes: «geometria» debe encontrar
  /// «Geometría». Se recalcula cada vez que se guarda el proyecto.
  searchText String @default("")

  /// Ruta del PDF dentro del almacenamiento privado.
  ///
  /// El nombre lo genera el sistema; el original del archivo se descarta a
  /// propósito, porque un PDF llamado «proyecto-maria-rodriguez.pdf» filtraría
  /// el nombre completo de una estudiante sin que nadie lo advirtiera.
  documentPath       String?
  documentSize       Int?
  documentUploadedAt DateTime?

  /// Primera página del documento, ya marcada, como archivo aparte.
  ///
  /// Es lo único que ve el público. Mostrar el PDF completo y poner al lado un
  /// botón de solicitud sería un adorno: el visor de cualquier navegador
  /// permite guardar lo que muestra. Limitando la vista a una página, pedir el
  /// documento completo vuelve a tener sentido.
  previewPath String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authors  Author[]
  requests DocumentRequest[]

  @@index([status, publishedAt])
  @@index([area])
  @@index([gradeLevel])
  @@index([year])
}

/// Estudiante autor de un proyecto.
///
/// Se guarda el nombre completo porque el colegio lo necesita para su propio
/// registro, pero al público solo se muestra reducido: nombre más inicial del
/// apellido. El nombre completo únicamente se publica si un administrador
/// marca que la familia firmó la autorización (Ley 1581 de 2012).
model Author {
  id        String @id @default(cuid())
  projectId String

  /// Nombres y apellidos se guardan separados a propósito: deducir dónde
  /// termina el nombre en «María Fernanda Rodríguez Gómez» es adivinar, y
  /// adivinar mal publica más de lo autorizado.
  givenNames  String
  familyNames String

  fullNameAuthorized Boolean @default(false)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// Estado de una solicitud de documento.
enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Solicitud de alguien del público para consultar el PDF de un proyecto.
///
/// Quien solicita no crea cuenta: deja su nombre, un correo y el motivo. Son
/// datos personales de un adulto, no de un estudiante, pero igualmente se
/// guardan solo mientras hagan falta para atender la solicitud.
model DocumentRequest {
  id        String @id @default(cuid())
  projectId String

  requesterName  String
  requesterEmail String
  reason         String

  status    RequestStatus @default(PENDING)
  createdAt DateTime      @default(now())

  decidedAt   DateTime?
  decidedById String?
  /// Nota del administrador al rechazar, para poder explicar el motivo.
  decisionNote String?

  /// Del enlace de entrega solo se guarda su huella: el enlace en claro se
  /// entrega una vez y no debe poder reconstruirse desde la base de datos.
  tokenHash      String?   @unique
  tokenExpiresAt DateTime?
  /// Marca el momento en que se usó. Un enlace usado no vuelve a servir.
  tokenUsedAt    DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  decidedBy User?  @relation(fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([projectId])
}
